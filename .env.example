# =============================================================================
# Crane SEO Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
#   cp .env.example .env
# =============================================================================

# --- DataForSEO API (用于关键词研究、排名追踪、SERP 分析) ---
DATAFORSEO_EMAIL=your-email@example.com
DATAFORSEO_API_KEY=your_dataforseo_api_key_here

# --- AI 模型 (OpenAI 兼容 API，用于 AI 内容分析、SEO 建议) ---
# 支持所有 OpenAI 兼容接口：OpenAI / DeepSeek / Moonshot / 智谱 / 通义千问 / Ollama 等
# 如果留空，AI 功能将不可用
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Google Cloud APIs (免费额度内使用) ---
# GCP 项目只需创建 1 个，在同一个项目里开启以下 API：
#   - PageSpeed Insights API
#   - Search Console API
#   - Google Analytics Data API
#   - Indexing API
#   - Cloud Natural Language API
GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_FILE=/path/to/gcp-service-account-key.json

# Google Search Console (OAuth 2.0)
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret
GSC_REFRESH_TOKEN=your-gsc-refresh-token

# Google PageSpeed Insights
PAGESPEED_API_KEY=your-pagespeed-api-key

# Google Analytics Data API (GA4)
GA4_PROPERTY_ID=properties/123456789
GA4_CLIENT_EMAIL=your-ga4-service-account@project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----"

# Google Indexing API
INDEXING_SERVICE_ACCOUNT_KEY=/path/to/indexing-service-account.json

# --- Bing Webmaster Tools API (免费) ---
BING_API_KEY=your-bing-webmaster-api-key
BING_SITE_URL=https://your-site.com

# --- WhoisJSON API (免费 1000次/月) ---
WHOIS_API_KEY=your-whoisjson-api-key

# --- ValueSERP API (备用 SERP，按量付费) ---
VALUESERP_API_KEY=your-valueserp-api-key

# --- Database ---
DATABASE_URL=postgresql://crane_user:crane_password@postgres:5432/crane_seo
POSTGRES_USER=crane_user
POSTGRES_PASSWORD=crane_password
POSTGRES_DB=crane_seo

# --- Redis ---
# 独立部署时使用容器内 Redis：redis://redis:6379/0
# Kejilion 环境部署时复用宿主机 Redis：redis://@host.docker.internal:6379/1
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
# Kejilion 环境 Redis 密码（如果 kejilion 的 Redis 设置了密码）
KEJILION_REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- API Server ---
API_PORT=8080
API_HOST=0.0.0.0
NODE_ENV=development

# --- Crawler ---
CRAWLER_CONCURRENCY=5
CRAWLER_MAX_REQUESTS_PER_MINUTE=60
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; CraneSEOBot/1.0; +https://crane-seo.com/bot)
CRAWLER_RESPECT_ROBOTS_TXT=true

# --- Admin UI ---
ADMIN_UI_PORT=3000

# --- Nginx ---
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- Google My Business ---
GMB_CLIENT_ID=your_gmb_client_id
GMB_CLIENT_SECRET=your_gmb_client_secret
GMB_REFRESH_TOKEN=your_gmb_refresh_token

# --- YouTube API ---
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- App Store / Google Play ---
APPLE_STORE_CONNECT_KEY_ID=your_key_id
APPLE_STORE_CONNECT_ISSUER_ID=your_issuer_id
APPLE_STORE_CONNECT_PRIVATE_KEY_PATH=/path/to/private_key.p8

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Deploy Domain (Kejilion 部署时使用) ---
# 用于 Nginx 反向代理配置中的 server_name 和 CORS 设置
DOMAIN=seo.example.com